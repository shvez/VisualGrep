<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:VisualGrep.ViewModels;assembly=VisualGrep"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
			 x:Class="VisualGrep.Avalonia.Views.FileTabView"
			 x:DataType="vm:FileTabViewModel">
	<Grid RowDefinitions="28,*">
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="2">
			<ComboBox Grid.Column="0"
					  x:Name="EncodingComboBox"
					  Width="90"
					  VerticalAlignment="Center"
					  ItemsSource="{Binding AvailableEncodings}"
					  SelectedItem="{Binding SelectedEncoding}"
					  DisplayMemberBinding="{Binding Name}"
					  SelectionChanged="EncodingComboBox_OnSelectionChanged" />
			<TextBox Grid.Column="1"
					 Margin="4,0,0,0"
					 IsReadOnly="True"
					 Text="{Binding FullFilePath}"
					 VerticalAlignment="Center"
					 VerticalContentAlignment="Center" />
		</Grid>
		<Border Grid.Row="1"
				BorderBrush="Gray"
				BorderThickness="1">
			<ListBox x:Name="FileLinesListBox"
					 ItemsSource="{Binding Lines}"
					 SelectedIndex="{Binding SelectedLineIndex}"
					 Padding="0"
					 Background="Transparent"
					 BorderThickness="0">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Padding" Value="0" />
						<Setter Property="MinHeight" Value="0" />
					</Style>
				</ListBox.Styles>
				<ListBox.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Open file externally" Click="OpenFileExternally_Click" />
					</ContextMenu>
				</ListBox.ContextMenu>
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<VirtualizingStackPanel />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="x:String">
						<TextBlock Text="{Binding}"
								   TextTrimming="CharacterEllipsis"
								   FontFamily="{Binding $parent[ListBox].((vm:FileTabViewModel)DataContext).LogFontFamily}"
								   FontSize="14" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>
	</Grid>
</UserControl>
